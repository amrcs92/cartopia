{
    "name": "cartopia-showcase",
    "private": true,
    "type": "module",
    "description": "Screenshots and the walkthrough video for Cartopia's README.",
    "scripts": {
        "screenshots": "tsx capture/screenshots.ts",
        "clips": "tsx capture/clips.ts",
        "voice:samples": "voice/.venv/Scripts/python voice/narrate.py --samples",
        "voice": "voice/.venv/Scripts/python voice/narrate.py --final",
        "music": "voice/.venv/Scripts/python video/music/compose.py",
        "render": "tsx video/scripts/render.ts",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/node": "22.15.30",
        "playwright": "1.64.1",
        "tsx": "4.20.3",
        "typescript": "5.9.3",
        "vitest": "3.2.4"
    }
}
