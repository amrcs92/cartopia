{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "types": ["node"]
    },
    "include": ["capture/**/*.ts", "video/**/*.ts", "video/**/*.tsx", "remotion.config.ts"]
}
